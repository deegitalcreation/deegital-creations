<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Deegital Creations — Creative Designs</title>
<meta name="description" content="Deegital Creations — digital invitations, posters, branding, packaging and custom designs.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600&display=swap" rel="stylesheet">

<style>
:root{--ink:#25211f;--muted:#766d68;--paper:#fbf8f4;--card:#fff;--line:#e9e1da;--accent:#9a665c;--accent2:#d8b8ad}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--ink);background:var(--paper);font-family:"DM Sans",sans-serif}
a{text-decoration:none;color:inherit}.wrap{max-width:1180px;margin:auto;padding:0 24px}
header{position:sticky;top:0;z-index:20;background:rgba(251,248,244,.94);backdrop-filter:blur(12px);border-bottom:1px solid rgba(233,225,218,.7)}
.nav{height:76px;display:flex;align-items:center;justify-content:space-between}.logo{font-weight:700;letter-spacing:.08em;font-size:15px}.navlinks{display:flex;gap:28px;font-size:14px;color:var(--muted)}.navlinks a:hover{color:var(--ink)}
.cartbtn{border:1px solid var(--line);background:#fff;padding:10px 15px;border-radius:999px;cursor:pointer;font:inherit}.count{display:inline-grid;place-items:center;background:var(--ink);color:#fff;width:20px;height:20px;border-radius:50%;font-size:11px;margin-left:5px}
.hero{padding:95px 0 80px;display:grid;grid-template-columns:1.1fr .9fr;gap:70px;align-items:center}.eyebrow{text-transform:uppercase;letter-spacing:.18em;font-size:11px;color:var(--accent);font-weight:700}.hero h1{font-family:"Playfair Display",serif;font-size:clamp(48px,7vw,86px);line-height:.98;margin:16px 0 24px;font-weight:500}.hero p{font-size:17px;line-height:1.7;color:var(--muted);max-width:560px}.buttons{display:flex;gap:12px;margin-top:30px;flex-wrap:wrap}.btn{display:inline-flex;align-items:center;justify-content:center;padding:13px 21px;border-radius:999px;border:1px solid var(--ink);font-weight:600;font-size:14px}.btn.dark{background:var(--ink);color:#fff}.btn.light{background:#fff;border-color:var(--line)}
.heroart{aspect-ratio:1/1;border-radius:28px;background:linear-gradient(145deg,#ead7ce,#f7eee9 52%,#d6b8ad);position:relative;overflow:hidden}.heroart:before{content:"";position:absolute;width:62%;height:62%;border-radius:50%;background:rgba(255,255,255,.45);left:18%;top:16%}.hero-card{position:absolute;background:#fffaf6;width:58%;height:66%;left:21%;top:17%;box-shadow:0 24px 55px rgba(65,40,30,.16);display:flex;align-items:center;justify-content:center;text-align:center;padding:25px}.hero-card div{border:1px solid #d7c1b8;width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center}.hero-card small{letter-spacing:.2em;font-size:9px;color:#8d756c}.hero-card strong{font-family:"Playfair Display",serif;font-size:30px;font-weight:500;margin:10px 0}.hero-card span{font-size:10px;color:#8d756c}
.section{padding:78px 0}.sectionhead{display:flex;justify-content:space-between;align-items:end;margin-bottom:30px}.section h2{font-family:"Playfair Display",serif;font-size:42px;font-weight:500;margin:8px 0}.sectionhead p{color:var(--muted);max-width:480px;line-height:1.6}
.filters{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:28px}.filter{padding:9px 14px;border:1px solid var(--line);border-radius:999px;background:#fff;cursor:pointer;font:inherit;font-size:13px}.filter.active{background:var(--ink);color:#fff;border-color:var(--ink)}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.product{background:#fff;border:1px solid var(--line);border-radius:20px;overflow:hidden}.thumb{aspect-ratio:1/1;background:#eee1da;display:grid;place-items:center;position:relative;overflow:hidden}.thumb span{font-family:"Playfair Display",serif;font-size:26px;color:#80665d;text-align:center;padding:30px}.pbody{padding:18px}.pbody h3{margin:0 0 6px;font-size:16px}.meta{color:var(--muted);font-size:13px}.prow{display:flex;justify-content:space-between;align-items:center;margin-top:15px}.price{font-weight:700}.add{border:0;background:var(--ink);color:#fff;border-radius:999px;padding:10px 14px;cursor:pointer;font:inherit;font-size:12px}
.about{background:#f0e6df}.aboutgrid{display:grid;grid-template-columns:.8fr 1.2fr;gap:70px;align-items:center}.aboutbox{font-family:"Playfair Display",serif;font-size:48px;line-height:1.08}.about p{color:var(--muted);line-height:1.8}
.cta{background:var(--ink);color:#fff;border-radius:28px;padding:55px;display:flex;justify-content:space-between;align-items:center;gap:30px}.cta h2{font-family:"Playfair Display",serif;font-size:42px;font-weight:500;margin:0 0 10px}.cta p{color:#cfc7c2;margin:0}.cta .btn{background:#fff;color:var(--ink);border-color:#fff}
footer{padding:45px 0;color:var(--muted);font-size:13px}.footerrow{display:flex;justify-content:space-between;gap:20px;border-top:1px solid var(--line);padding-top:25px}
.whatsapp{position:fixed;right:22px;bottom:22px;z-index:30;background:#1f9d59;color:#fff;border-radius:999px;padding:13px 17px;font-weight:700;box-shadow:0 12px 30px rgba(0,0,0,.18)}
.drawer{position:fixed;inset:0;z-index:50;pointer-events:none}.drawer.show{pointer-events:auto}.shade{position:absolute;inset:0;background:rgba(20,15,12,.35);opacity:0;transition:.25s}.drawer.show .shade{opacity:1}.panel{position:absolute;right:0;top:0;height:100%;width:min(430px,100%);background:#fff;padding:25px;transform:translateX(100%);transition:.3s;display:flex;flex-direction:column}.drawer.show .panel{transform:none}.panelhead{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding-bottom:18px}.close{border:0;background:none;font-size:24px;cursor:pointer}.items{flex:1;overflow:auto;padding:15px 0}.item{display:flex;gap:13px;padding:15px 0;border-bottom:1px solid var(--line)}.itemimg{width:70px;height:70px;border-radius:12px;background:#eadbd4;display:grid;place-items:center;font-family:"Playfair Display",serif;font-size:10px;text-align:center}.iteminfo{flex:1}.iteminfo b{font-size:13px}.qty{display:flex;align-items:center;gap:10px;margin-top:8px}.qty button{width:25px;height:25px;border:1px solid var(--line);background:#fff;border-radius:50%;cursor:pointer}.checkout{border-top:1px solid var(--line);padding-top:18px}.total{display:flex;justify-content:space-between;font-weight:700;margin-bottom:15px}.empty{color:var(--muted);text-align:center;padding:45px 10px}
@media(max-width:800px){.navlinks{display:none}.hero{grid-template-columns:1fr;gap:35px;padding-top:55px}.heroart{max-width:520px}.grid{grid-template-columns:repeat(2,1fr)}.aboutgrid{grid-template-columns:1fr;gap:20px}.cta{padding:35px;display:block}.cta .btn{margin-top:25px}.sectionhead{display:block}}
@media(max-width:520px){.wrap{padding:0 17px}.grid{grid-template-columns:1fr}.hero h1{font-size:54px}.section{padding:55px 0}.hero{padding-bottom:45px}.footerrow{display:block}.footerrow div+div{margin-top:10px}}

/* Shop layout improvements */
#shop .sectionhead{display:grid;grid-template-columns:1fr .8fr;gap:48px;align-items:center;margin-bottom:36px}
#shop .sectionhead h2{font-size:clamp(44px,4.5vw,58px);line-height:1.12;margin-top:12px}
#shop .sectionhead p{font-size:16px;line-height:1.8;max-width:440px;margin:0}
#shop .filters{gap:10px;margin-bottom:30px}
#shop .grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:26px}
#shop .product{background:var(--card);border:1px solid var(--line);border-radius:18px;overflow:hidden;min-width:0;transition:transform .2s ease,box-shadow .2s ease}
#shop .product:hover{transform:translateY(-3px);box-shadow:0 14px 35px rgba(65,40,30,.09)}
#shop .thumb{width:100%;aspect-ratio:4/5;height:auto;display:block;background-color:#eee1da;background-size:cover;background-position:center;overflow:hidden}
#shop .pbody{padding:20px}
#shop .pbody h3{font-size:17px;line-height:1.5}
#shop .filter{padding:10px 17px;border:1px solid var(--line);border-radius:999px;background:#fff;font-size:13px}
#shop .filter.active{background:var(--ink);color:#fff;border-color:var(--ink)}
#shop .add{padding:11px 16px;border-radius:999px;background:var(--ink);color:#fff;border:0;font-size:12px}
@media(max-width:800px){
  #shop .sectionhead{grid-template-columns:1fr;gap:10px}
  #shop .grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
}
@media(max-width:520px){
  #shop .grid{grid-template-columns:1fr}
  #shop .sectionhead h2{font-size:42px}
  #shop .pbody{padding:16px}
  #shop .prow{align-items:flex-start;flex-wrap:wrap}
}

</style>
</head>
<body>
<header><div class="wrap nav">
<a class="logo" href="#">DEEGITAL CREATIONS</a>
<nav class="navlinks"><a href="#shop">Shop</a><a href="#about">About</a><a href="#custom">Custom Design</a><a href="#contact">Contact</a></nav>
<button class="cartbtn" onclick="openCart()">Cart <span class="count" id="cartCount">0</span></button>
</div></header>

<main>
<section class="hero wrap">
<div><div class="eyebrow">Digital Design Studio</div><h1>Designs made for your special moments.</h1><p>Beautiful, thoughtful and ready-to-use designs for weddings, celebrations, businesses and everything in between.</p><div class="buttons"><a class="btn dark" href="#shop">Shop Designs</a><a class="btn light" href="#custom">Need a Custom Design?</a></div></div>
<div class="heroart"><div class="hero-card"><div><small>DEEGITAL CREATIONS</small><strong>Made with<br>love & detail</strong><span>INVITATIONS · BRANDING · DESIGN</span></div></div></div>
</section>

<section class="section wrap" id="shop">
<div class="sectionhead"><div><div class="eyebrow">The Collection</div><h2>Shop our designs</h2></div><p>Browse ready-made designs and add your favourites to cart. Product images, prices and checkout details can be updated anytime.</p></div>
<div class="filters" id="filters"></div>
<div class="grid" id="products"></div>
</section>

<section class="section about" id="about"><div class="wrap aboutgrid"><div class="aboutbox">Thoughtful design,<br>made beautifully.</div><div><div class="eyebrow">About Deegital Creations</div><p>Deegital Creations is a creative design studio creating digital designs that are simple, beautiful and memorable. From wedding stationery to business visuals, every piece is designed with attention to detail.</p><p>Have something specific in mind? Let's create something made just for you.</p></div></div></section>

<section class="section wrap" id="custom"><div class="cta"><div><div class="eyebrow" style="color:#d8b8ad">Custom Design</div><h2>Have an idea?</h2><p>Tell us what you need and we'll help turn your idea into a design.</p></div><a class="btn" id="customWa" href="#" target="_blank">Chat on WhatsApp</a></div></section>
</main>


<footer id="contact">
  <div class="wrap footerrow">
    <div>
      <b>DEEGITAL CREATIONS</b><br>
      Creative designs for every occasion.
    </div>
    <div>
      © <span id="year"></span> Deegital Creations
    </div>
  </div>
</footer>

<a class="whatsapp" id="waFloat" href="#" target="_blank">WhatsApp ↗</a>

<div class="drawer" id="drawer"><div class="shade" onclick="closeCart()"></div><aside class="panel"><div class="panelhead"><b>Your Cart</b><button class="close" onclick="closeCart()">×</button></div><div class="items" id="cartItems"></div><div class="checkout"><div class="total"><span>Total</span><span id="total">RM0.00</span></div><button class="btn dark" style="width:100%;cursor:pointer" onclick="checkout()">Proceed to Checkout</button><div style="font-size:11px;color:#8a817c;text-align:center;margin-top:10px">Payment gateway can be connected here once your payment provider is selected.</div></div></aside></div>

<script is:inline>
const WHATSAPP_NUMBER = "60123456789"; // TODO: replace with your real WhatsApp number before launch
let products = [];

let cart = JSON.parse(localStorage.getItem("deegitalCart")||"[]");
const money = n => "RM"+n.toFixed(2);
function waLink(message){return "https://wa.me/"+WHATSAPP_NUMBER+"?text="+encodeURIComponent(message)}
function renderFilters(){
 const cats=["All",...new Set(products.map(p=>p.cat))];
 document.getElementById("filters").innerHTML=cats.map((c,i)=>`<button class="filter ${i===0?"active":""}" onclick="filterProducts('${c}',this)">${c}</button>`).join("");
}
function renderProducts(list=products){
 document.getElementById("products").innerHTML=list.map(p=>`<article class="product">
 <div class="thumb" style="background-image:url('${p.image.startsWith('/')?p.image:'/'+p.image}');background-size:cover;background-position:center"></div>
 <div class="pbody"><h3>${p.name}</h3><div class="meta">${p.cat}</div><div class="prow"><span class="price">${money(p.price)}</span><button class="add" onclick="addToCart(${p.id})">Add to Cart</button></div></div>
 </article>`).join("");
}
function filterProducts(cat,btn){document.querySelectorAll(".filter").forEach(x=>x.classList.remove("active"));btn.classList.add("active");renderProducts(cat==="All"?products:products.filter(p=>p.cat===cat))}
function addToCart(id){const found=cart.find(x=>x.id===id);if(found)found.qty++;else cart.push({id,qty:1});save();openCart()}
function removeItem(id){cart=cart.filter(x=>x.id!==id);save()}
function changeQty(id,d){const x=cart.find(x=>x.id===id);if(!x)return;x.qty+=d;if(x.qty<=0)removeItem(id);else save()}
function save(){localStorage.setItem("deegitalCart",JSON.stringify(cart));renderCart()}
function renderCart(){
 document.getElementById("cartCount").textContent=cart.reduce((s,x)=>s+x.qty,0);
 const box=document.getElementById("cartItems");
 if(!cart.length){box.innerHTML='<div class="empty">Your cart is empty.<br><br>Choose a design you love ✦</div>';document.getElementById("total").textContent="RM0.00";return}
 let total=0;
 box.innerHTML=cart.map(x=>{const p=products.find(y=>y.id===x.id);total+=p.price*x.qty;return `<div class="item"><div class="itemimg">${p.tag}</div><div class="iteminfo"><b>${p.name}</b><div class="meta">${money(p.price)}</div><div class="qty"><button onclick="changeQty(${p.id},-1)">−</button><span>${x.qty}</span><button onclick="changeQty(${p.id},1)">+</button><button style="border:0;background:none;color:#a66;cursor:pointer;margin-left:auto" onclick="removeItem(${p.id})">Remove</button></div></div></div>`}).join("");
 document.getElementById("total").textContent=money(total);
}
function openCart(){document.getElementById("drawer").classList.add("show");renderCart()}
function closeCart(){document.getElementById("drawer").classList.remove("show")}
function checkout(){
 if(!cart.length)return;
 const lines=cart.map(x=>{const p=products.find(y=>y.id===x.id);return `${p.name} x${x.qty} — ${money(p.price*x.qty)}`});
 const total=cart.reduce((s,x)=>s+products.find(y=>y.id===x.id).price*x.qty,0);
 const msg=`Hi Deegital Creations! I'd like to place an order:\\n\\n${lines.join("\\n")}\\n\\nTotal: ${money(total)}\\n\\nPlease let me know the next step for payment.`;
 window.open(waLink(msg),"_blank");
}
async function loadProducts(){
 try{ const r=await fetch("/data/products.json?"+Date.now()); products=(await r.json()).map(p=>({...p,cat:p.cat||p.category||"Other",tag:p.tag||p.name||"Design preview"})); }
 catch(e){ products=[]; }
 renderFilters(); renderProducts(); renderCart();
}
document.getElementById("waFloat").href=waLink("Hi Deegital Creations! I would like to ask about your designs.");
document.getElementById("customWa").href=waLink("Hi Deegital Creations! I would like to enquire about a custom design.");
document.getElementById("year").textContent=new Date().getFullYear();
loadProducts();
</script>
</body>
</html>
